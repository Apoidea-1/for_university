<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_networkpilot_reminder_tree" model="ir.ui.view">
            <field name="name">networkpilot.reminder.tree</field>
            <field name="model">networkpilot.reminder</field>
            <field name="arch" type="xml">
                <tree decoration-danger="due_date &lt; current_date and status != 'completed'" decoration-success="status == 'completed'">
                    <field name="due_date"/>
                    <field name="title"/>
                    <field name="contact_id"/>
                    <field name="reminder_type"/>
                    <field name="status" widget="badge" 
                           decoration-success="status == 'completed'" 
                           decoration-info="status == 'active'"/>
                </tree>
            </field>
        </record>

        <record id="view_networkpilot_reminder_form" model="ir.ui.view">
            <field name="name">networkpilot.reminder.form</field>
            <field name="model">networkpilot.reminder</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="title"/>
                                <field name="contact_id"/>
                                <field name="reminder_type"/>
                            </group>
                            <group>
                                <field name="due_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_networkpilot_reminder_kanban" model="ir.ui.view">
            <field name="name">networkpilot.reminder.kanban</field>
            <field name="model">networkpilot.reminder</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="title"/>
                    <field name="status"/>
                    <field name="due_date"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div><strong><field name="title"/></strong></div>
                                <div><field name="contact_id"/></div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="due_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="reminder_type"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_networkpilot_reminder" model="ir.actions.act_window">
            <field name="name">Reminders</field>
            <field name="res_model">networkpilot.reminder</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <menuitem id="menu_networkpilot_reminders_all" 
                  name="All Reminders" 
                  parent="menu_networkpilot_reminders" 
                  action="action_networkpilot_reminder" 
                  sequence="10"/>
    </data>
</odoo>
