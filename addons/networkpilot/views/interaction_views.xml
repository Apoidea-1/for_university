<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_networkpilot_interaction_tree" model="ir.ui.view">
            <field name="name">networkpilot.interaction.tree</field>
            <field name="model">networkpilot.interaction</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="interaction_date"/>
                    <field name="contact_id"/>
                    <field name="interaction_type"/>
                    <field name="title"/>
                </tree>
            </field>
        </record>

        <record id="view_networkpilot_interaction_form" model="ir.ui.view">
            <field name="name">networkpilot.interaction.form</field>
            <field name="model">networkpilot.interaction</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="title"/>
                                <field name="contact_id"/>
                                <field name="interaction_type"/>
                            </group>
                            <group>
                                <field name="interaction_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_networkpilot_interaction" model="ir.actions.act_window">
            <field name="name">Interactions</field>
            <field name="res_model">networkpilot.interaction</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_networkpilot_interactions_all" 
                  name="All Interactions" 
                  parent="menu_networkpilot_interactions" 
                  action="action_networkpilot_interaction" 
                  sequence="10"/>
    </data>
</odoo>
