<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_networkpilot" model="ir.module.category">
            <field name="name">Networkpilot</field>
            <field name="description">Personal CRM Access Rights</field>
            <field name="sequence">10</field>
        </record>

        <!-- Groups -->
        <record id="group_networkpilot_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_networkpilot"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_networkpilot_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_networkpilot"/>
            <field name="implied_ids" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <!-- Record Rules: User sees only their own records -->
        <record id="rule_networkpilot_contact_personal" model="ir.rule">
            <field name="name">Personal Contacts</field>
            <field name="model_id" ref="model_networkpilot_contact"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>
        
        <record id="rule_networkpilot_category_personal" model="ir.rule">
            <field name="name">Personal Categories</field>
            <field name="model_id" ref="model_networkpilot_category"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_tag_personal" model="ir.rule">
            <field name="name">Personal Tags</field>
            <field name="model_id" ref="model_networkpilot_tag"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_interaction_personal" model="ir.rule">
            <field name="name">Personal Interactions</field>
            <field name="model_id" ref="model_networkpilot_interaction"/>
            <field name="domain_force">[('contact_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_reminder_personal" model="ir.rule">
            <field name="name">Personal Reminders</field>
            <field name="model_id" ref="model_networkpilot_reminder"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_ai_suggestion_personal" model="ir.rule">
            <field name="name">Personal AI Suggestions</field>
            <field name="model_id" ref="model_networkpilot_ai_suggestion"/>
            <field name="domain_force">[('contact_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_integration_personal" model="ir.rule">
            <field name="name">Personal Integrations</field>
            <field name="model_id" ref="model_networkpilot_integration"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_activity_log_personal" model="ir.rule">
            <field name="name">Personal Activity Logs</field>
            <field name="model_id" ref="model_networkpilot_activity_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_contact_relationship_personal" model="ir.rule">
            <field name="name">Personal Contact Relationships</field>
            <field name="model_id" ref="model_networkpilot_contact_relationship"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <record id="rule_networkpilot_contact_message_personal" model="ir.rule">
            <field name="name">Personal Contact Messages</field>
            <field name="model_id" ref="model_networkpilot_contact_message"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_user'))]"/>
        </record>

        <!-- Manager Rules (See All) -->
        <record id="rule_networkpilot_contact_all" model="ir.rule">
            <field name="name">All Contacts</field>
            <field name="model_id" ref="model_networkpilot_contact"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_manager'))]"/>
        </record>
        
        <record id="rule_networkpilot_category_all" model="ir.rule">
            <field name="name">All Categories</field>
            <field name="model_id" ref="model_networkpilot_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_networkpilot_manager'))]"/>
        </record>
        <!-- And so on for managers... keeping it simple, they see everything -->

    </data>
</odoo>
